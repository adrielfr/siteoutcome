{
  "name": "siteoutcome",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "OUTCOME_DB",
      "database_name": "outcome-db",
      "database_id": "8b59ed0c-52af-4bd2-8eb7-9230880fa2cc",
      "migrations_dir": "./migrations"
    }
  ]
}
